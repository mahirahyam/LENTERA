<UserControl x:Class="LENTERA.WPF.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Tabel Reservasi -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Kelola Reservasi" FontSize="28" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Cari, tinjau, dan kelola seluruh pengajuan reservasi laboratorium." Foreground="{DynamicResource SubTextColor}" FontSize="14" Margin="0,0,0,16"/>

                <TextBox Width="340" HorizontalAlignment="Left"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         ToolTip="Ketik kode booking, nama peminjam, lab, atau status..."/>
            </StackPanel>

            <!-- DataGrid Container Card -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgColor}" CornerRadius="14" Padding="16" Effect="{DynamicResource CardShadow}">
                <DataGrid ItemsSource="{Binding FilteredBookings}" SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                          RowHeaderWidth="0" RowHeight="46">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource SubTextColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                        </Style>

                        <!-- Style perbaikan saat DataGridCell / Nama Dipencet -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <!-- Style perbaikan saat Baris Dipencet -->
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource InputBgColor}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KODE" Binding="{Binding KodeBooking}" Width="90"/>
                        <DataGridTextColumn Header="PEMINJAM" Binding="{Binding NamaPeminjam}" Width="*"/>
                        <DataGridTextColumn Header="LABORATORIUM" Binding="{Binding NamaLab}" Width="150"/>
                        <DataGridTextColumn Header="TANGGAL" Binding="{Binding Tanggal, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="JAM" Binding="{Binding JamText}" Width="110"/>
                        <DataGridTemplateColumn Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left"
                                            ToolTip="{Binding AlasanPenolakan}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource StatusPendingBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Disetujui">
                                                        <Setter Property="Background" Value="{DynamicResource StatusApprovedBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Ditolak">
                                                        <Setter Property="Background" Value="{DynamicResource StatusRejectedBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusPendingFg}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disetujui">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusApprovedFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ditolak">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusRejectedFg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Aksi untuk baris yang dipilih -->
            <Border Grid.Row="2" Margin="0,16,0,0" Background="{DynamicResource CardBgColor}" CornerRadius="14" Padding="16,14" Effect="{DynamicResource CardShadow}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource SubTextColor}" FontSize="12"
                               Text="Pilih satu baris di atas untuk menyetujui, menolak, atau menghapus reservasi."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Setujui" Command="{Binding SetujuiBookingCommand}" Style="{StaticResource NavButton}"
                                Foreground="#15803D" Margin="0,0,6,0"/>
                        <Button Content="Tolak" Command="{Binding TolakBookingCommand}" Style="{StaticResource NavButton}"
                                Foreground="#B91C1C" Margin="0,0,6,0"/>
                        <Button Content="Hapus" Command="{Binding HapusBookingCommand}" Style="{StaticResource NavButton}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
