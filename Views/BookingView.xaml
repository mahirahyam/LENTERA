<UserControl x:Class="LENTERA.WPF.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Tabel Reservasi -->
        <Grid Grid.Column="0" Margin="0,0,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Kelola Reservasi" FontSize="28" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Cari, buat, dan pantau status pengajuan reservasi laboratorium." Foreground="{DynamicResource SubTextColor}" FontSize="14" Margin="0,0,0,16"/>

                <TextBox Width="340" HorizontalAlignment="Left"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         ToolTip="Ketik kode booking, nama peminjam, atau lab..."/>
            </StackPanel>

            <!-- DataGrid Container Card -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgColor}" CornerRadius="14" Padding="16" Effect="{DynamicResource CardShadow}">
                <DataGrid ItemsSource="{Binding FilteredBookings}" 
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                          RowHeaderWidth="0" RowHeight="46">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource SubTextColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                        </Style>

                        <!-- Style perbaikan saat DataGridCell / Nama Dipencet -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <!-- Style perbaikan saat Baris Dipencet -->
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource InputBgColor}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KODE" Binding="{Binding KodeBooking}" Width="90"/>
                        <DataGridTextColumn Header="PEMINJAM" Binding="{Binding NamaPeminjam}" Width="*"/>
                        <DataGridTextColumn Header="LABORATORIUM" Binding="{Binding NamaLab}" Width="160"/>
                        <DataGridTextColumn Header="TANGGAL" Binding="{Binding Tanggal, StringFormat=\{0:dd/MM/yyyy\}}" Width="110"/>
                        <DataGridTemplateColumn Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource StatusPendingBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Disetujui">
                                                        <Setter Property="Background" Value="{DynamicResource StatusApprovedBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Ditolak">
                                                        <Setter Property="Background" Value="{DynamicResource StatusRejectedBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusPendingFg}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disetujui">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusApprovedFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ditolak">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusRejectedFg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Form Inset Card -->
        <Border Grid.Column="1" Background="{DynamicResource CardBgColor}" CornerRadius="14" Padding="28" Effect="{DynamicResource CardShadow}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Buat Reservasi Baru" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="Nama Peminjam" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding NewBooking.NamaPeminjam, Mode=TwoWay}" Margin="0,0,0,16"/>

                <TextBlock Text="Pilih Laboratorium" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding DaftarLaboratorium}" 
                          SelectedItem="{Binding NewBooking.NamaLab, Mode=TwoWay}" 
                          Margin="0,0,0,16"/>

                <TextBlock Text="Keperluan Kegiatan" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding NewBooking.Keperluan, Mode=TwoWay}" Margin="0,0,0,16"/>

                <TextBlock Text="Jumlah Peserta" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding NewBooking.JumlahPeserta, Mode=TwoWay}" Margin="0,0,0,24"/>

                <!-- Tombol Ajukan Permohonan -->
                <Button Content="Ajukan Permohonan" Command="{Binding SimpanBookingCommand}" 
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>