<Window x:Class="LENTERA.WPF.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LENTERA" Height="230" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgColor}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap"
                   Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,12"/>
        <TextBox x:Name="InputBox" Grid.Row="2" VerticalAlignment="Top"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Batal" Width="90" Margin="0,0,10,0" Click="Batal_Click"/>
            <Button Content="Simpan" Width="90" Style="{StaticResource PrimaryButton}" Click="Simpan_Click"/>
        </StackPanel>
    </Grid>
</Window>
