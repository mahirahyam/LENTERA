<UserControl x:Class="LENTERA.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28">
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="Dashboard Reservasi" FontSize="28" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Pantau pemanfaatan laboratorium dan status persetujuan jadwal secara real-time." 
                           Foreground="{DynamicResource SubTextColor}" FontSize="14"/>
            </StackPanel>

            <UniformGrid Columns="4" Margin="0,0,0,32">
                <Border Background="{DynamicResource CardBgColor}" CornerRadius="12" Padding="20" Margin="0,0,10,0" Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Total Lab Aktif" Foreground="{DynamicResource SubTextColor}" FontSize="13" FontWeight="SemiBold"/>
                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentColor}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Text="{Binding TotalLabAktif}" FontSize="32" FontWeight="Bold" Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBgColor}" CornerRadius="12" Padding="20" Margin="5,0,5,0" Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Booking Hari Ini" Foreground="{DynamicResource SubTextColor}" FontSize="13" FontWeight="SemiBold"/>
                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Text="{Binding BookingHariIni}" FontSize="32" FontWeight="Bold" Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBgColor}" CornerRadius="12" Padding="20" Margin="5,0,5,0" Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Menunggu Persetujuan" Foreground="{DynamicResource SubTextColor}" FontSize="13" FontWeight="SemiBold"/>
                        <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Text="{Binding MenungguPersetujuan}" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBgColor}" CornerRadius="12" Padding="20" Margin="10,0,0,0" Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Total Pengguna" Foreground="{DynamicResource SubTextColor}" FontSize="13" FontWeight="SemiBold"/>
                        <Border Width="8" Height="8" CornerRadius="4" Background="#6366F1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Text="{Binding TotalPengguna}" FontSize="32" FontWeight="Bold" Margin="0,12,0,0"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Background="{DynamicResource CardBgColor}" CornerRadius="14" Padding="28" Effect="{DynamicResource CardShadow}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,24">
                        <TextBlock Text="Frekuensi Penggunaan Laboratorium" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <TextBlock Text="Bulan Ini" Foreground="{DynamicResource SubTextColor}" FontSize="13" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding GrafikPenggunaan}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="220" VerticalAlignment="Bottom"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0">
                                    <TextBlock Text="{Binding TotalBooking}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                    <Border Width="48" Height="{Binding BarHeight}" Background="{DynamicResource AccentColor}" CornerRadius="8,8,0,0"/>
                                    <TextBlock Text="{Binding NamaLab}" Margin="0,12,0,0" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>