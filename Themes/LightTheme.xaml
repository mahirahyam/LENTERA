<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgColor" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SidebarBgColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBgColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextColor" Color="#0F172A" />
    <SolidColorBrush x:Key="SubTextColor" Color="#64748B" />
    <SolidColorBrush x:Key="AccentColor" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverColor" Color="#1D4ED8" />
    <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0" />
    <SolidColorBrush x:Key="InputBgColor" Color="#F1F5F9" />

    <SolidColorBrush x:Key="StatusApprovedBg" Color="#DCFCE7" />
    <SolidColorBrush x:Key="StatusApprovedFg" Color="#15803D" />
    <SolidColorBrush x:Key="StatusPendingBg" Color="#FEF3C7" />
    <SolidColorBrush x:Key="StatusPendingFg" Color="#B45309" />
    <SolidColorBrush x:Key="StatusRejectedBg" Color="#FEE2E2" />
    <SolidColorBrush x:Key="StatusRejectedFg" Color="#B91C1C" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.05" />
</ResourceDictionary>