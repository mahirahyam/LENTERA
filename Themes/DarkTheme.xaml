<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgColor" Color="#0F172A" />
    <SolidColorBrush x:Key="SidebarBgColor" Color="#1E293B" />
    <SolidColorBrush x:Key="CardBgColor" Color="#1E293B" />
    <SolidColorBrush x:Key="TextColor" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SubTextColor" Color="#94A3B8" />
    <SolidColorBrush x:Key="AccentColor" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverColor" Color="#60A5FA" />
    <SolidColorBrush x:Key="BorderColor" Color="#334155" />
    <SolidColorBrush x:Key="InputBgColor" Color="#0F172A" />

    <SolidColorBrush x:Key="StatusApprovedBg" Color="#064E3B" />
    <SolidColorBrush x:Key="StatusApprovedFg" Color="#6EE7B7" />
    <SolidColorBrush x:Key="StatusPendingBg" Color="#78350F" />
    <SolidColorBrush x:Key="StatusPendingFg" Color="#FDE68A" />
    <SolidColorBrush x:Key="StatusRejectedBg" Color="#7F1D1D" />
    <SolidColorBrush x:Key="StatusRejectedFg" Color="#FCA5A5" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.3" />
</ResourceDictionary>