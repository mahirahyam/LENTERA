<Window x:Class="LENTERA.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LENTERA.WPF.ViewModels"
        xmlns:views="clr-namespace:LENTERA.WPF.Views"
        Title="LENTERA - Layanan Elektronik Terpadu Reservasi Laboratorium" 
        Height="768" Width="1240" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookingViewModel}">
            <views:BookingView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBgColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,28">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,36">
                        <Border Width="12" Height="24" Background="{DynamicResource AccentColor}" CornerRadius="4" Margin="0,0,12,0"/>
                        <TextBlock Text="LENTERA" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="MENU UTAMA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SubTextColor}" Margin="8,0,0,12"/>
                    <Button Content="Dashboard" Command="{Binding NavigateDashboardCommand}" Style="{StaticResource NavButton}" Margin="0,0,0,6"/>
                    <Button Content="Kelola Booking" Command="{Binding NavigateBookingCommand}" Style="{StaticResource NavButton}" Margin="0,0,0,6"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,16"/>
                    <Button Content="Ganti Tema (Dark/Light)" Command="{Binding ToggleThemeCommand}" Style="{StaticResource NavButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>